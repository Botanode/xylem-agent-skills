// Category collections — complete Xylem counterparts for all 12 cases.
// Generated from verified syntax; bounded arithmetic respects checked semantics.
const CASE: usize = 1
fn f001(n: i64, seed: i64) -> i64 effects [allocation] {
    let mut v: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < n { vec_push(&mut v, (i * 7 + seed) % 1000000007); i = i + 1 }
    let mut c: i64 = 0
    let mut j: usize = 0
    while j < vec_len(&v) { if let Option.Some(x) = vec_get(&v, j) { c = (c + *x) % 1000000007 }; j = j + 1 }
    return c
}

